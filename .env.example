# Environment Variables

## Backend (apps/api)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/megatrainer_db
OLLAMA_ENDPOINT=http://localhost:11434
COMFYUI_ENDPOINT=http://localhost:8188
# Portrait checkpoint profile: lightning (fast/lower quality), juggernaut or
# realvisxl (slower, full-step, higher quality). See image-engine/config.ts.
PORTRAIT_MODEL=juggernaut
MEDIA_DIR=./media
JWT_SECRET=dev-secret-change-in-production

## Frontend (apps/web)
NG_APP_API_URL=http://localhost:3000
NG_APP_WS_URL=http://localhost:3000
