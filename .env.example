# megaTrainer — environment
#
# Copy to `.env` and adjust. `.env` is git-ignored; only this template is tracked.
#
# Every variable below is read somewhere in the source. If you add one here, wire it
# up too — an env var nothing reads is worse than a missing one, because it looks
# like configuration that works.

## PostgreSQL connection used by apps/api/src/db.ts
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/megatrainer_db

## Where generated trainer/world images are written and served from.
## Read by apps/api/src/modules/media/storage.ts. Defaults to ./media if unset.
MEDIA_DIR=./media

## Local LLM used by coach-engine/config.ts for all coach + assessment calls.
## Defaults to http://127.0.0.1:11434 if unset.
OLLAMA_ENDPOINT=http://localhost:11434

## Model that coach-engine/config.ts selects for the heavier assessment prompts.
## Note this is hardcoded in the source (MODEL_HEAVY), not read from here.
# MODEL_HEAVY=gemma3:27b-it-qat

## Model docker-compose pulls on first boot via the one-shot `ollama-model-init`
## service. This is read by docker-compose.yml, not by the application code.
OLLAMA_MODEL=gemma4:e2b

## Local Stable Diffusion server used by image-engine/config.ts for trainer
## portraits and action shots. Defaults to http://127.0.0.1:8188 if unset.
COMFYUI_ENDPOINT=http://localhost:8188

## Which Stable Diffusion checkpoint profile image-engine/config.ts uses for
## portraits. Each profile pairs a checkpoint with sampler settings it was tuned
## for; steps and CFG are not interchangeable across checkpoints. Options:
##   lightning   — distilled, 8 steps, seconds per image, softer output
#   juggernaut  — 35 steps, slower, better facial detail (default)
#   realvisxl   — 30 steps, slower, photorealistic-leaning
# See PORTRAIT_MODEL_PROFILES in image-engine/config.ts.
PORTRAIT_MODEL=juggernaut
