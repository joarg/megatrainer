{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "drizzle": "bun run drizzle-kit studio",
    "build": "docker compose up -d --build--no-deps api",
    "db:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "docker:up:api:build": "docker compose up -d --build api",
    "db:migrate:api": "bun run db:generate && bun run docker:up:api:build"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "elysia": "^1.4.28",
    "drizzle-orm": "^0.45.2",
    "drizzle-typebox": "^0.3.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "bun-types": "latest",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10"
  },
  "module": "src/index.js"
}
