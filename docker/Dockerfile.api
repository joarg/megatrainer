# Bun Runtime Image for megatrainer API
FROM oven/bun:1.3-alpine

WORKDIR /app

# Copy API package metadata and sources
COPY apps/api/package.json ./package.json
COPY apps/api/src ./src
COPY coach-engine /coach-engine
COPY image-engine /image-engine

# Install API runtime dependencies
RUN bun install --production --no-save

# Environment defaults (override via docker-compose or run flags)
ENV NODE_ENV=production
ENV PORT=3000
ENV DATABASE_URL=postgresql://devuser:devpass@postgres:5432/megatrainer_db

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD bun run -e "const res = await fetch('http://localhost:3000/health'); process.exit(res.ok ? 0 : 1)" || exit 1

EXPOSE 3000

CMD ["bun", "run", "src/index.ts"]
