# Bun Dev Runtime Image for megatrainer API
FROM oven/bun:1.3-alpine

WORKDIR /app

# Copy API package metadata, source, and migration assets
COPY apps/api/package.json ./package.json
COPY apps/api/src ./src
COPY apps/api/drizzle.config.ts ./drizzle.config.ts
COPY apps/api/migrations ./migrations
COPY coach-engine /coach-engine
COPY image-engine /image-engine

# Copy startup entrypoint that runs migrate + studio + api
COPY docker/api-dev-entrypoint.sh /usr/local/bin/api-dev-entrypoint.sh

# Install dev dependencies (drizzle-kit is required at runtime for migrate/studio)
RUN chmod +x /usr/local/bin/api-dev-entrypoint.sh && bun install --no-save

ENV NODE_ENV=development
ENV PORT=3000
ENV DRIZZLE_STUDIO_PORT=4983
ENV DATABASE_URL=postgresql://devuser:devpass@postgres:5432/megatrainer_db

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD bun run -e "const res = await fetch('http://localhost:3000/health'); process.exit(res.ok ? 0 : 1)" || exit 1

EXPOSE 3000
EXPOSE 4983

CMD ["/usr/local/bin/api-dev-entrypoint.sh"]
