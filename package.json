{
  "name": "megatrainer-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Learning project: AI trainer onboarding platform. Bun+Elysia API, SvelteKit frontend, PostgreSQL/Drizzle, local Ollama + ComfyUI inference.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "bun run dev:api & bun run dev:web",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "bun run build:api && bun run build:web",
    "build:api": "docker compose up -d --build --no-deps api",
    "build:web": "cd apps/web && bun run build",
    "docker:build": "docker build -f docker/Dockerfile.api -t megatrainer-api:latest .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "docker:logs:api": "docker-compose -f docker-compose.yml logs -f api",
    "docker:logs": "docker-compose -f docker-compose.yml logs -f",
    "test": "bun test",
    "typecheck": "bun run typecheck:api && bun run typecheck:web",
    "typecheck:api": "cd apps/api && bunx tsc --noEmit -p tsconfig.json",
    "typecheck:web": "cd apps/web && bun run check",
    "check": "bun run test && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/openapi": "^1.4.14",
    "elysia": "^1.4.28"
  },
  "overrides": {
    "@sinclair/typebox": "0.34.0"
  }
}
